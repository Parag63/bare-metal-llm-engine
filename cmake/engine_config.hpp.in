#pragma once

// 1 when the build included CUDA kernels, 0 when this is a CPU-only build.
// Use this instead of __CUDACC__ in host code: __CUDACC__ tells you whether the
// *current translation unit* is being compiled by nvcc, which is a different
// question from whether the project has GPU support at all.
#cmakedefine01 ENGINE_CUDA_ENABLED
#define ENGINE_HAS_CUDA ENGINE_CUDA_ENABLED

#define ENGINE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ENGINE_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ENGINE_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define ENGINE_VERSION_STRING "@PROJECT_VERSION@"

// The CUDA architecture(s) this build targets, as a string, e.g. "89" for an RTX 4090.
// Empty on CPU-only builds. Printed by benchmarks so results are self-documenting.
#define ENGINE_CUDA_ARCH_STRING "@ENGINE_CUDA_ARCH@"

// Git commit hash of the build tree
#define ENGINE_GIT_HASH "@ENGINE_GIT_HASH@"
